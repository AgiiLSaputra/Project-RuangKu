# Salin berkas ini jadi .env lalu isi nilainya. Semua variabel juga bisa diset
# langsung di environment (mis. Environment Variables di dashboard Render).

# development | test | production
NODE_ENV=development
PORT=3000

# Wajib. Contoh lokal:  postgres://postgres:sandi@localhost:5432/ruangku
# Contoh Render (database terkelola wajib TLS): postgres://user:sandi@host/ruangku?sslmode=require
DATABASE_URL=postgres://postgres:sandi@localhost:5432/ruangku

# Wajib, minimal 32 karakter. Di Render gunakan `generateValue` (render.yaml).
JWT_SECRET=rahasia-kunci-jwt-minimal-32-karakter-panjang

# Daftar origin frontend yang boleh memanggil API (bisa beberapa, pisahkan koma).
# Saat deploy: isi dengan URL frontend asli, mis. https://ruangku-web.onrender.com
CORS_ORIGIN=http://localhost:5173

# Masa berlaku sesi login (hari).
JWT_EXPIRES_HARI=7

# Folder penyimpanan foto unggahan (relatif terhadap cwd server).
UPLOAD_DIR=uploads

# Alamat publik server — dipakai menyusun URL foto yang disimpan di database.
# Saat deploy: https://<nama-service>.onrender.com
PUBLIC_URL=http://localhost:3000
